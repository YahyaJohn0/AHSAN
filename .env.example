# Public browser configuration; Vite embeds only these allowlisted values.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.region.firebasedatabase.app
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_APP_ID=
API_BASE_URL=http://127.0.0.1:8081
# Node.js API runtime configuration; private values are used only by the server.
NODE_ENV=development
PORT=8080
ADMIN_UIDS=
ALLOW_LOCAL_ADMIN=true
CORS_ORIGINS=
TRUST_PROXY=1
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=zamzam
CLOUDINARY_ASSET_FOLDER=samples/ecommerce
