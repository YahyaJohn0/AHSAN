# ==============================================================================
# ZAMZAM ESSENTIALS - ENVIRONMENT VARIABLES & API CONFIGURATION
# ==============================================================================
# Note: This is a reference template. Copy this file to .env and fill in your values.
# Vite exposes variables prefixed with VITE_, FIREBASE_, CLOUDINARY_, and API_ to the browser.
# All other variables remain private to the Node.js Express server.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
# Environment mode (development | production)
NODE_ENV=development

# HTTP port for the Node.js Express backend server (default: 3000)
PORT=3000

# Base URL for API requests from the browser (defaults to window.location.origin)
# Both API_BASE_URL and VITE_API_BASE_URL are supported by client & server
API_BASE_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000

# Allowed CORS origins for cross-origin API calls (comma-separated, leave blank for same-origin)
CORS_ORIGINS=

# Reverse proxy setting for Express (1 or true when behind a load balancer / Cloudflare)
TRUST_PROXY=1

# Hot Module Replacement toggle (used internally by AI Studio sandbox)
DISABLE_HMR=false


# ------------------------------------------------------------------------------
# 2. FIREBASE AUTHENTICATION API (STRICTLY FOR USER & ADMIN AUTH)
# ------------------------------------------------------------------------------
# Firebase Web API key used for client authentication and identity REST lookups
FIREBASE_API_KEY=AIzaSyYourFirebaseWebApiKeyHere
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseWebApiKeyHere

# Firebase Auth domain (e.g. your-project-id.firebaseapp.com)
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# Firebase Project ID
FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase Web Application ID (e.g. 1:123456789:web:abcdef123456)
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# (Optional) Path to Google Service Account JSON file for server-side Firebase Admin SDK
GOOGLE_APPLICATION_CREDENTIALS=


# ------------------------------------------------------------------------------
# 3. STORE ADMINISTRATION & ACCESS CONTROL
# ------------------------------------------------------------------------------
# Comma-separated Firebase User UIDs designated as Store Administrators
ADMIN_UIDS=your-admin-firebase-uid-1,your-admin-firebase-uid-2

# Allows local developer admin login fallback when running locally (true | false)
ALLOW_LOCAL_ADMIN=true


# ------------------------------------------------------------------------------
# 4. CLOUDINARY MEDIA & IMAGE ASSET MANAGEMENT API
# ------------------------------------------------------------------------------
# Complete Cloudinary connection URI (server-side authenticated uploads & management)
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Cloudinary Cloud Name (used by both client and backend)
CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Cloudinary API Key (used for signing server requests and client uploads)
CLOUDINARY_API_KEY=your_cloudinary_api_key

# Cloudinary API Secret (server-side only, NEVER expose to the browser)
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Cloudinary Upload Preset (used for client direct and unsigned uploads)
CLOUDINARY_UPLOAD_PRESET=zamzam
VITE_CLOUDINARY_UPLOAD_PRESET=zamzam

# Root folder for store product images within your Cloudinary account
CLOUDINARY_ASSET_FOLDER=samples/ecommerce


# ------------------------------------------------------------------------------
# 5. MONGODB / FIRESTORE MONGODB-COMPATIBLE DATABASE API
# ------------------------------------------------------------------------------
# MongoDB-compatible connection string for Google Firestore MongoDB API
FIRESTORE_URL=mongodb://your-firestore-mongo-host:27017/default?ssl=true

# Standard MongoDB connection string (e.g. MongoDB Atlas cluster or local instance)
MONGO_URL=mongodb+srv://user:password@cluster0.mongodb.net/zamzam?retryWrites=true&w=majority


# ------------------------------------------------------------------------------
# 6. GOOGLE GEMINI AI API (via @google/genai SDK)
# ------------------------------------------------------------------------------
# API key for Google Gemini Generative AI models (server-side only)
# The backend automatically detects either GOOGLE_API_KEY or GEMINI_API_KEY
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here
